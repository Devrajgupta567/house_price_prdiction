# ═══════════════════════════════════════════════════════════
# ValuAltion — Environment Variables Reference
# ═══════════════════════════════════════════════════════════
# Copy this file to .env for local development.
# On Render, set these in the dashboard under each service's
# "Environment" tab. Never commit real secrets to git.
# ═══════════════════════════════════════════════════════════

# ── DATABASE (set automatically by Render Blueprint) ──────
DATABASE_URL=jdbc:postgresql://localhost:5432/valualtion
DATABASE_USERNAME=valualtion_user
DATABASE_PASSWORD=your_db_password

# ── ML SERVICE (set automatically by Render Blueprint) ────
ML_SERVICE_URL=http://localhost:8000

# ── JWT SECRET (generated automatically by Render) ────────
JWT_SECRET=your_256bit_hex_secret_here

# ── SMTP / EMAIL ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=getvalaltion@gmail.com
SMTP_PASSWORD=your_gmail_app_password   # ← Set this in Render dashboard!
EMAIL_ENABLED=true

# ── CORS (set automatically by Render Blueprint) ──────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── FRONTEND (Vite build-time variable) ───────────────────
VITE_API_BASE_URL=http://localhost:9090/api/v1
